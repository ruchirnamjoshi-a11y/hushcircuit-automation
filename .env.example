# B-roll sources — optional, unused by default (pipeline/broll.py kept but not called)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI scene illustrations (FLUX.1-schnell via Cloudflare Workers AI)
# Free Cloudflare account, no credit card required. Create an API token at
# dash.cloudflare.com -> My Profile -> API Tokens -> "Workers AI" template
# (Read is enough). Account ID is on the Cloudflare dashboard's Workers & Pages
# overview page. 10,000 free Neurons/day — see README for details.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Weekly story generation (pipeline/story_writer.py, run_weekly_story_refill.py)
# Free key from aistudio.google.com/apikey — copy the "API Key" value shown
# in the key details panel exactly (format has changed over time; don't
# assume a fixed prefix). Free tier covers this pipeline's weekly usage
# (~28 requests/week across 4 tracks) with room to spare. If unset, the
# weekly refill step just skips instead of failing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# YouTube Data/Analytics API — one OAuth Desktop client (Google Cloud
# Console), shared across all 4 channels:
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
# Each track uploads to its OWN YouTube channel and needs its own OAuth
# token. Locally these default to secrets/youtube_token_<track>.json
# (created by `python -m pipeline.upload --auth-setup --track <track>`) —
# only set these overrides if you want a non-default path. In GitHub
# Actions, the per-track secrets (YOUTUBE_TOKEN_B64_KIDS etc.) are restored
# to those default paths directly — see README's multi-channel setup.
# YOUTUBE_TOKEN_FILE_KIDS=secrets/youtube_token_kids.json
# YOUTUBE_TOKEN_FILE_TEENS=secrets/youtube_token_teens.json
# YOUTUBE_TOKEN_FILE_ADULTS=secrets/youtube_token_adults.json
# YOUTUBE_TOKEN_FILE_WOMEN=secrets/youtube_token_women.json

# TTS voice fallback for direct pipeline/tts.py usage outside the track
# system (each track's real voice is set in pipeline/config.py's TRACKS)
TTS_VOICE=en-US-GuyNeural

# Content settings
NICHE=Daily stories for every age
CHANNEL_TITLE_PREFIX=
