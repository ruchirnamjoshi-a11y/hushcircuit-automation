# B-roll sources — optional, unused by default (pipeline/broll.py kept but not called)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI scene illustrations (FLUX.1-schnell via Cloudflare Workers AI)
# Free Cloudflare account, no credit card required. Create an API token at
# dash.cloudflare.com -> My Profile -> API Tokens -> "Workers AI" template
# (Read is enough). Account ID is on the Cloudflare dashboard's Workers & Pages
# overview page. 10,000 free Neurons/day — see README for details.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# YouTube Data/Analytics API (Google Cloud Console OAuth client)
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# TTS voice (any edge-tts voice name; run `edge-tts --list-voices` to see options)
TTS_VOICE=en-US-GuyNeural

# Content settings
NICHE=AI tools & tips
CHANNEL_TITLE_PREFIX=
